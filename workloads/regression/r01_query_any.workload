# The empty query mask. Contract rule 5 asks for the digest over every live
# entity whose mask is a superset of `required`, and every live entity's mask
# is a superset of the empty one. Before `any` could be written in query_masks
# no workload asked this, and sparse_set and grouped_sparse_set answered 0.
# Destroys and recycled slots make "live" matter; entities with one component
# make the answer differ from any one component's population.
id: r01_query_any
visibility: public
track: ecs
seed: 7101
initial_entities: 3000
max_entities: 5000
frames: 120
ops_per_frame: 600
w_create: 1.0
w_destroy: 1.2
w_add: 1.0
w_remove: 1.0
w_get: 1.0
w_set: 1.0
access: uniform
integrate_per_frame: true
query_masks: any, position+velocity, tag, any
p_position: 0.5
p_velocity: 0.5
p_health: 0.3
p_tag: 0.3
