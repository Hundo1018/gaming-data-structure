# A tall narrow world (9 x 9 x 81 cells of edge 5), so grid_ring_knn walks the
# by_xy order and clips every shell past four cells across. The population of
# 300 drains by 38 a tick to nothing, and a rewind every tenth tick, nine deep,
# puts all 300 back through a fresh instance. Queries meet a full world, a
# population below k = 6, and an empty one (knn's live_count == 0 return, and
# cell_sorted's rebuild of an empty directory).
id: r3_drain_tall_rewind_full
visibility: hidden
track: spatial
seed: 9321
world_size: 40
world_height: 400
initial_entities: 300
ticks: 40
inserts_per_tick: 2
removes_per_tick: 40
move_fraction: 1.0
speed_min: 0.5
speed_max: 10.0
teleport_ratio: 0.05
placement: uniform
radius_queries_per_tick: 16
entity_radius_queries_per_tick: 16
knn_queries_per_tick: 32
query_radius_min: 4
query_radius_max: 6
knn_k: 6
query_focus: uniform
rewind_every: 10
rewind_depth: 9
history_ticks: 9
verify_sweep_ticks: 1
