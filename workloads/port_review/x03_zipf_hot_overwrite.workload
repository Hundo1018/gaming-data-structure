# A few hot entities take most of the traffic, so the same entity is added to
# while it holds the component, removed from while it lacks it, and set and
# read in bursts. No integrate: every memo query_memo keeps is reused.
id: x03_zipf_hot_overwrite
visibility: public
track: ecs
seed: 9103
initial_entities: 3000
max_entities: 3000
frames: 100
ops_per_frame: 1500
w_create: 0.3
w_destroy: 0.3
w_add: 3.0
w_remove: 3.0
w_get: 2.0
w_set: 2.0
access: zipf
zipf_exponent: 1.3
access_width: 2
burst_frame_ratio: 0.2
burst_multiplier: 4
stale_access_ratio: 0.1
integrate_per_frame: false
dt: 0.5
query_masks: velocity, position+tag, health
p_position: 1.0
p_velocity: 1.0
p_health: 1.0
p_tag: 1.0
verify_sweep_frames: 4
