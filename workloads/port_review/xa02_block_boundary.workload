# One group only (every entity holds exactly Position+Velocity) that grows by
# one row a frame from 250 to about 650, so fused_archetype's fused walk runs
# with n crossing 256 and 512: one partial block, then exact multiples of
# kFuseRows, then a remainder of one. The second query is answered by the
# parent's loop after the first cleared the pending step. dt is not a power
# of two, so any reordering of the step's float arithmetic would show.
id: xa02_block_boundary
visibility: public
track: ecs
seed: 7702
initial_entities: 250
max_entities: 4000
frames: 400
ops_per_frame: 1
w_create: 1.0
w_destroy: 0.0
w_add: 0.0
w_remove: 0.0
w_get: 0.0
w_set: 0.0
access: uniform
integrate_per_frame: true
dt: 0.3712
query_masks: position+velocity, position
p_position: 1.0
p_velocity: 1.0
p_health: 0.0
p_tag: 0.0
verify_sweep_frames: 1
