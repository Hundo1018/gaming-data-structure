# The typical query radius is NaN: query_radius_min and max are nan, which
# strtod accepts. The C++ held grid takes its cell edge from
# std::max(typical, floor), which is (typical < floor) ? floor : typical and so
# NaN: its grid collapses to a single cell. uniform_grid's C init writes the max
# as typical > floor ? typical : floor, which gives the floor of 0.25, so the C
# grid has 257 x 257 x 65 cells. Every radius is NaN, so no point is ever inside
# one, and the k-nearest answers agree; reported_bytes and peak_bytes do not.
# No entity-centred queries: with a NaN radius an entity does not find itself,
# and its own term would be subtracted from an empty sum, which fails verify in
# both builds alike. Rewinds every 7, 3 deep, cross record frames.
id: dgr01_nan_typical_radius
visibility: public
track: spatial
seed: 9201
world_size: 64
world_height: 16
initial_entities: 1500
ticks: 60
inserts_per_tick: 10
removes_per_tick: 10
move_fraction: 0.05
speed_min: 0.5
speed_max: 3.0
teleport_ratio: 0.1
placement: uniform
radius_queries_per_tick: 8
entity_radius_queries_per_tick: 0
knn_queries_per_tick: 12
knn_k: 6
query_radius_min: nan
query_radius_max: nan
query_focus: uniform
rewind_every: 7
rewind_depth: 3
history_ticks: 4
verify_sweep_ticks: 1
