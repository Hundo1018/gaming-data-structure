# Held out. Rollback with every entity moving every tick: the undo log has to
# record the whole population each tick, which is what a snapshot does anyway,
# and then pay two index operations per record to unwind it.
id: hs01_rewind_all_moving
visibility: hidden
track: spatial
seed: 8001
world_size: 1024
world_height: 256
initial_entities: 30000
ticks: 200
inserts_per_tick: 20
removes_per_tick: 15
move_fraction: 1.0
speed_min: 0.5
speed_max: 4.0
placement: uniform
radius_queries_per_tick: 48
entity_radius_queries_per_tick: 48
knn_queries_per_tick: 12
query_radius_min: 8
query_radius_max: 16
knn_k: 8
rewind_every: 10
rewind_depth: 6
history_ticks: 12
